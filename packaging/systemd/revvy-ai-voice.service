[Unit]
Description=Revvy AI offline hotword listener
After=graphical-session.target pipewire.service revvy-ai.service
Wants=revvy-ai.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/opt/ttos/revvy-ai/bin/revvy-ai-voice-listener
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
