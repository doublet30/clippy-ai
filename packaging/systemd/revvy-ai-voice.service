[Unit]
Description=Revvy AI offline hotword listener
After=pipewire.service pipewire-pulse.service wireplumber.service revvy-ai.service
Wants=pipewire.service pipewire-pulse.service wireplumber.service revvy-ai.service

[Service]
Type=simple
ExecStart=/opt/ttos/revvy-ai/bin/revvy-ai-voice-listener
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
