#!/usr/bin/env bash
# Offline Revvy AI hotword and command listener.
# PocketSphinx does all recognition locally. It listens continuously only for
# the configured hotword, then opens a short microphone capture window and
# forwards the final transcription to the resident Revvy AI command service.
set -euo pipefail

config_file="${XDG_CONFIG_HOME:-$HOME/.config}/revvy-ai/config.json"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/revvy-ai"
model_dir="/usr/share/pocketsphinx/model/en-us"
dictionary="$model_dir/cmudict-en-us.dict"
acoustic_model="$model_dir/en-us"
language_model="$model_dir/en-us.lm.bin"
revvy_bin="${REVVY_AI_BIN:-/usr/local/bin/revvy-ai}"

command -v pocketsphinx_continuous >/dev/null || { echo "revvy-ai-voice: pocketsphinx is unavailable" >&2; exit 1; }
command -v arecord >/dev/null || { echo "revvy-ai-voice: arecord is unavailable" >&2; exit 1; }

read_setting() {
    python3 - "$config_file" <<'PY'
import json, sys
defaults = {
    "enabled": False,
    "hotword": "Hey Revvy!",
    "commandSeconds": 8,
    "cooldownSeconds": 2,
    "keywordThreshold": "1e-30",
}
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        settings = json.load(f).get("speechRecognition", {})
except Exception:
    settings = {}
for key, default in defaults.items():
    value = settings.get(key, default)
    print(str(value).lower() if isinstance(value, bool) else value)
PY
}

mapfile -t settings < <(read_setting)
enabled="${settings[0]:-false}"
hotword="${settings[1]:-Hey Revvy!}"
command_seconds="${settings[2]:-8}"
cooldown_seconds="${settings[3]:-2}"
keyword_threshold="${settings[4]:-1e-30}"

if [[ "$enabled" != "true" ]]; then
    exit 0
fi

[[ -f "$dictionary" && -d "$acoustic_model" && -f "$language_model" ]] || {
    echo "revvy-ai-voice: PocketSphinx English model is unavailable" >&2
    exit 1
}

# Revvy is not in CMUdict. Add its pronunciation to a private copy while
# retaining every standard English word for editable hotwords and commands.
mkdir -p "$cache_dir"
runtime_dictionary="$cache_dir/revvy-en-us.dict"
if [[ ! -f "$runtime_dictionary" || "$dictionary" -nt "$runtime_dictionary" ]]; then
    cp "$dictionary" "$runtime_dictionary"
    printf '\nREVVY R EH V IY\n' >> "$runtime_dictionary"
fi

normalize() {
    tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:] '
}
normalized_hotword=$(printf '%s' "$hotword" | normalize | xargs)
[[ -n "$normalized_hotword" ]] || normalized_hotword="hey revvy"

log() {
    printf 'revvy-ai-voice: %s\n' "$*" >&2
}

show_processing() {
    # Circle AI fades in and enters its active ring state here.  Sprite themes
    # use their matching Processing animation.  The prompt itself will later
    # take over the normal request/response lifecycle.
    "$revvy_bin" -a Processing >/dev/null 2>&1 || true
}

settle_visual() {
    # A hotword with no recognized command still needs a visible completion.
    # For Circle AI, Idle starts its standard 20-second fade-away timer.
    "$revvy_bin" -a Idle >/dev/null 2>&1 || true
}

capture_and_dispatch() {
    local wav transcript
    wav=$(mktemp --suffix=.wav "${XDG_RUNTIME_DIR:-/tmp}/revvy-ai-command.XXXXXX")
    trap 'rm -f "$wav"' RETURN
    # arecord writes a WAV file PocketSphinx can decode directly. A missing
    # microphone is a cancelled command, not a service failure.
    if ! arecord -q -f S16_LE -r 16000 -c 1 -d "$command_seconds" "$wav"; then
        log "microphone capture failed; returning to idle"
        settle_visual
        return 0
    fi
    transcript=$(pocketsphinx_continuous -infile "$wav" -hmm "$acoustic_model" \
        -dict "$runtime_dictionary" -lm "$language_model" 2>/dev/null \
        | awk 'NF { result=$0 } END { print result }')
    transcript=$(printf '%s' "$transcript" | xargs)
    if [[ -z "$transcript" ]]; then
        log "no command recognized; returning to idle"
        settle_visual
        return 0
    fi
    log "recognized a command; dispatching it to Revvy"
    "$revvy_bin" -p "$transcript" >/dev/null 2>&1 || settle_visual
}

log "listening for hotword: $hotword"
while :; do
    # A keyword-only decoder is cheap to leave running. Stop it before
    # recording the command so the microphone is never opened twice.
    # PocketSphinx normally block-buffers stdout when it is piped.  Without
    # stdbuf, a detected phrase can sit in that buffer and never reach read()
    # until much later, making an otherwise healthy service look unresponsive.
    coproc HOTWORD { stdbuf -oL pocketsphinx_continuous -inmic yes -hmm "$acoustic_model" \
        -dict "$runtime_dictionary" -keyphrase "$normalized_hotword" \
        -kws_threshold "$keyword_threshold" 2>/dev/null; }
    hotword_pid=$HOTWORD_PID
    detected=false
    while IFS= read -r line <&"${HOTWORD[0]}"; do
        normalized_line=$(printf '%s' "$line" | normalize | xargs)
        if [[ "$normalized_line" == *"$normalized_hotword"* ]]; then
            detected=true
            break
        fi
    done
    kill "$hotword_pid" >/dev/null 2>&1 || true
    wait "$hotword_pid" 2>/dev/null || true
    if [[ "$detected" == true ]]; then
        log "hotword detected; opening command window"
        show_processing
        capture_and_dispatch
    fi
    sleep "$cooldown_seconds"
done
